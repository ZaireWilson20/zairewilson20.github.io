---
import { url, getTags } from '../lib/data';

interface Props { current?: 'blog' | 'tags' | 'portfolio' }
const { current } = Astro.props;
const hasTags = (await getTags()).size > 0;
const links = [
  { id: 'blog', label: 'Blog', href: url('/blog') },
  ...(hasTags ? [{ id: 'tags', label: 'Tags', href: url('/tags') }] : []),
  { id: 'portfolio', label: 'Portfolio', href: url('/portfolio') },
];
---
<header>
  <nav>
    <ul>
      {links.map((l) =>
        l.id === current
          ? <a href={l.href}><li class="current btn-nav">{l.label}</li></a>
          : <a href={l.href}><li class="btn-nav">{l.label}</li></a>
      )}
    </ul>
  </nav>
</header>
