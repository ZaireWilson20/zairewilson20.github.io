---
import { now, url } from '../lib/data';

const isExternal = (href: string) => href.includes('://');
---
<section id="now" class="portfolio-section">
  <div class="section-wrap">
    <div class="section-head">
      <p class="eyebrow">01</p>
      <h2 class="title">Currently Building</h2>
      <p class="lede">Side projects and experiments I'm working on right now.</p>
    </div>
    <div class="now-list">
      {now.map((item) => (
        <article class="now-item">
          <div class="now-meta">
            <span class="status">{item.status}</span>
            {item.since && <span class="since">since {item.since}</span>}
          </div>
          <h3 class="now-title">{item.title}</h3>
          <p class="now-summary">{item.summary}</p>
          {item.tags && (
            <ul class="tag-list">{item.tags.map((t: string) => <li>{t}</li>)}</ul>
          )}
          <div class="now-actions">
            {item.project && (
              <a type="button" class="text-btn" onclick={`open_modal('${item.project}')`}>More Info &rarr;</a>
            )}
            {(item.links ?? []).map((link: any) =>
              isExternal(link.url)
                ? <a class="text-btn" href={link.url} target="_blank" rel="noopener">{link.label} &rarr;</a>
                : <a class="text-btn" href={url(link.url)}>{link.label} &rarr;</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
