---
// Design: Avatar treatment. a = multiplied onto the wall color, b = flattened (blur + contrast),
// c = ink duotone (grayscale, posterized to 5 tones by an SVG filter).
import { site, url, type Variant } from '../../lib/data';

interface Props { variant: Variant }
const { variant } = Astro.props;
const p = site.profile;
---
<div class="avatar">
  <img class={`v-${variant}`} src={url(p.image)} alt={`Illustrated portrait of ${p.username}`} />
  {variant === 'c' && (
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <filter id="zw-flat" color-interpolation-filters="sRGB">
        <feGaussianBlur stdDeviation="1.6" />
        <feComponentTransfer>
          <feFuncR type="discrete" tableValues="0.04 0.28 0.52 0.78 1" />
          <feFuncG type="discrete" tableValues="0.04 0.28 0.52 0.78 1" />
          <feFuncB type="discrete" tableValues="0.04 0.28 0.52 0.78 1" />
        </feComponentTransfer>
      </filter>
    </svg>
  )}
</div>

<style>
  .avatar {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .v-a {
    mix-blend-mode: multiply;
  }
  .v-b {
    filter: blur(0.8px) contrast(1.25) saturate(1.1);
  }
  .v-c {
    mix-blend-mode: multiply;
    filter: grayscale(1) contrast(1.6) brightness(1.18) url(#zw-flat);
  }
</style>
