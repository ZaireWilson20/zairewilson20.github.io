---
// Design: Button. a = pill with a hard shadow, b = doorbell plate, c = inline link whose fill rises on hover.
import { design, type Variant } from '../../lib/data';

interface Props {
  href: string;
  color?: 'mustard' | 'pink' | 'sky' | 'panel';
  external?: boolean;
  variant?: Variant;
}
const { href, color = 'mustard', external = false, variant = design.button } = Astro.props;
// Doorbells and inline links need a real color where the pill uses the panel gray
const accent = color === 'panel' && variant !== 'a' ? 'sky' : color;
---
<a class:list={['btn', `v-${variant}`]} data-color={accent} data-panel={color === 'panel' ? '' : undefined} href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  {variant === 'b' && <span class="bell" aria-hidden="true"></span>}
  <span class="label"><slot /></span>
</a>

<style>
  .btn {
    text-decoration: none;
  }

  /* a: pill */
  .v-a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 26px;
    background: var(--accent);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 999px;
    box-shadow: 5px 5px 0 var(--ink);
    font: 700 18px/1 var(--body);
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .v-a[data-panel],
  .v-a[data-panel]:hover {
    color: var(--text);
  }
  .v-a:hover {
    color: var(--ink);
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--ink);
  }
  .v-a:active {
    transform: translate(4px, 4px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  /* b: doorbell plate */
  .v-b {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 7px 18px 7px 7px;
    background: var(--cream);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 14px;
    box-shadow: 4px 4px 0 var(--ink);
    font: 700 14px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: transform 0.1s, box-shadow 0.1s;
  }
  .v-b:hover {
    color: var(--ink);
    transform: rotate(-2deg);
  }
  .v-b:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--ink);
  }
  .bell {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--ink);
    box-shadow: inset -3px -3px 0 rgba(0, 0, 0, 0.18);
  }

  /* c: inline link, fill rises on hover */
  .v-c {
    padding: 0 3px 2px;
    color: var(--text);
    font: 700 20px/1.3 var(--body);
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% 5px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.25s, color 0.25s;
  }
  .v-c:hover {
    background-size: 100% 100%;
    color: var(--ink);
  }
</style>
