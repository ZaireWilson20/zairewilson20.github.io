---
// Design: Button variant a. Pill with a hard shadow that presses flat.
interface Props {
  href: string;
  color?: 'mustard' | 'pink' | 'sky' | 'panel';
  external?: boolean;
}
const { href, color = 'mustard', external = false } = Astro.props;
---
<a class="btn" data-color={color} href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}><slot /></a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 26px;
    background: var(--accent);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 999px;
    box-shadow: 5px 5px 0 var(--ink);
    font: 700 18px/1 var(--body);
    text-decoration: none;
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .btn[data-color='panel'],
  .btn[data-color='panel']:hover {
    color: var(--text);
  }
  .btn:hover {
    color: var(--ink);
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--ink);
  }
  .btn:active {
    transform: translate(4px, 4px);
    box-shadow: 1px 1px 0 var(--ink);
  }
</style>
