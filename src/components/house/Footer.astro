---
// Design: Footer variant a. The doormat.
import { site } from '../../lib/data';
const email = site.icons?.email;
---
<footer class="footer">
  <div class="mat">please wipe your feet</div>
  <div class="row">
    <div class="who">
      {site.profile.username}
      {email && <> · <a href={`mailto:${email}`}>{email}</a></>}
    </div>
    <div class="built">BUILT WITH ASTRO.</div>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
    padding: 56px var(--gutter) 36px;
    background: var(--void);
    border-top: 4px solid var(--ink);
  }
  .mat {
    padding: 22px clamp(24px, 5vw, 46px);
    background-color: var(--mustard);
    background-image: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.09) 0 2px, transparent 2px 6px);
    border: 4px solid var(--ink);
    border-radius: 12px;
    box-shadow: 8px 8px 0 var(--ink);
    transform: rotate(-1.5deg);
    font: 400 clamp(22px, 4vw, 30px) / 1 var(--disp);
    color: var(--ink);
    text-align: center;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    width: 100%;
    max-width: 1084px;
  }
  .who {
    font: 400 18px/1.4 var(--body);
    color: var(--cream);
    overflow-wrap: anywhere;
  }
  .who a {
    color: var(--cream);
  }
  .who a:hover {
    color: var(--pink);
  }
  .built {
    font: 400 12px/1.6 var(--mono);
    letter-spacing: 0.2em;
    color: var(--cream);
    opacity: 0.75;
  }
</style>
