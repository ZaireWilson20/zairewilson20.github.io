---
// Design: GalleryTile. a = colored mat, b = on a plinth (round), c = under a spotlight.
import { url, design, type Variant } from '../../lib/data';

interface Props { tile: any; variant?: Variant }
const { tile: t } = Astro.props;
// design.yml `tile: mix` keeps each tile's own variant; a/b/c forces one style for the whole room
const variant = Astro.props.variant ?? (design.tile === 'mix' ? t.variant ?? 'a' : design.tile);
const style = `--ratio: ${t.ratio ?? '1/1'}; --tile-tilt: ${Number(t.tilt ?? 0)}deg`;
const src = t.image ? url(t.image) : null;
---
<figure class:list={['tile', `v-${variant}`]} data-color={t.color ?? 'sky'} style={style}>
  {variant === 'a' && (
    <>
      <div class="mat">
        <div class="art">{src ? <img src={src} alt={t.alt ?? t.caption} loading="lazy" /> : t.label}</div>
      </div>
      <figcaption>{t.caption}</figcaption>
    </>
  )}
  {variant === 'b' && (
    <>
      <div class="bust">{src ? <img src={src} alt={t.alt ?? t.caption} loading="lazy" /> : t.label}</div>
      <div class="plinth"><figcaption>{t.caption}</figcaption></div>
    </>
  )}
  {variant === 'c' && (
    <div class="spot">
      <div class="art">{src ? <img src={src} alt={t.alt ?? t.caption} loading="lazy" /> : t.label}</div>
      <figcaption>{t.caption}</figcaption>
    </div>
  )}
</figure>

<style>
  .tile {
    margin: 0;
    width: 100%;
    min-width: 0;
  }
  figcaption {
    font: 400 12px/1.3 var(--mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .art {
    display: grid;
    place-items: center;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border: 3px solid var(--ink);
    background: repeating-linear-gradient(135deg, var(--cream) 0 10px, #ddd5c7 10px 20px);
    font: 400 12px/1 var(--mono);
    color: #5d5850;
  }

  /* a: colored mat */
  .v-a {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .v-a .mat {
    padding: 18px;
    background: var(--accent);
    border: 4px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    transform: rotate(calc(var(--tilt) * var(--tile-tilt)));
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .v-a .mat:hover {
    transform: rotate(0deg);
  }

  /* b: bust on a plinth */
  .v-b {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .v-b .bust {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 64%;
    aspect-ratio: 1 / 1;
    margin-bottom: -4px;
    overflow: hidden;
    border: 4px solid var(--ink);
    border-radius: 50%;
    background: repeating-linear-gradient(135deg, var(--accent) 0 10px, var(--cream) 10px 20px);
    box-shadow: 6px 6px 0 var(--ink);
    font: 400 12px/1 var(--mono);
    color: var(--ink);
  }
  .v-b .plinth {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 80%;
    height: 130px;
    padding-bottom: 18px;
    background: var(--cream);
    border: 4px solid var(--ink);
    box-shadow: 8px 0 0 var(--ink);
  }
  .v-b figcaption {
    padding: 5px 9px;
    border: 2px solid var(--ink);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink);
    text-transform: uppercase;
    text-align: center;
  }

  /* c: under a spotlight */
  .v-c .spot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: 36px 28px 24px;
    background:
      radial-gradient(ellipse 60% 75% at 50% 0%, rgba(255, 244, 220, 0.22), rgba(255, 244, 220, 0) 70%),
      var(--void);
  }
  .v-c .art {
    width: 100%;
    border-width: 4px;
    background: repeating-linear-gradient(135deg, var(--accent) 0 10px, var(--cream) 10px 20px);
    box-shadow: 14px 14px 0 rgba(0, 0, 0, 0.35);
  }
  .v-c figcaption {
    color: var(--cream);
  }
</style>
