---
// Design: Hero. a = crooked arch (hover leans it further), b = pink door left ajar onto open sky
// (hover swings it shut-ish), c = front door with peephole, nameplate, and a résumé in the mail slot.
import Button from './Button.astro';
import Avatar from './Avatar.astro';
import { site, url, design, type Variant } from '../../lib/data';

interface Props { variant?: Variant; avatar?: Variant | 'auto'; buttons?: Variant }
const { variant = design.hero, avatar = design.avatar, buttons = design.button } = Astro.props;
const av: Variant = avatar === 'auto' ? (variant === 'a' ? 'a' : 'b') : avatar;

const p = site.profile;
const [first, ...rest] = p.username.split(' ');
const github = site.icons?.github ? `https://github.com/${site.icons.github}` : null;
const resume = url(p.resume_url);
---
<section class:list={['hero', 'wrap', `v-${variant}`]}>
  <div class="copy">
    <p class="mono-label">{p.location} · Software Engineer</p>
    <h1><span>{first}</span><span>{rest.join(' ')}</span></h1>
    <p class="tagline">{p.tagline}</p>
    <p class="quip">{p.quip}</p>
    <div class="actions">
      <Button href={resume} color="mustard" variant={buttons} external>Resume →</Button>
      {github && <Button href={github} color="panel" variant={buttons} external>GitHub</Button>}
      {site.icons?.linkedin && <Button href={site.icons.linkedin} color="panel" variant={buttons} external>LinkedIn</Button>}
    </div>
  </div>

  <div class="door-stage">
    <div class="breathe">
      {variant === 'a' && (
        <div class="arch-door">
          <div class="arch"></div>
          <div class="portrait"><Avatar variant={av} /></div>
          <div class="sign knock">PLEASE KNOCK</div>
        </div>
      )}
      {variant === 'b' && (
        <div class="ajar">
          <div class="sky">
            <div class="sky-portrait"><Avatar variant={av} /></div>
          </div>
          <div class="leaf" aria-hidden="true">
            <div class="panel-inset"></div>
            <div class="knob"></div>
          </div>
          <div class="sign come-in">COME IN</div>
        </div>
      )}
      {variant === 'c' && (
        <div class="front">
          <div class="peephole"><Avatar variant={av} /></div>
          <div class="nameplate">Z. WILSON · NO. 20</div>
          <div class="slot">
            <a class="letter" href={resume} target="_blank" rel="noopener">RÉSUMÉ ↑</a>
          </div>
          <div class="knob"></div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px 56px;
    padding-top: clamp(32px, 6vw, 72px);
  }
  .copy {
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-bottom: clamp(24px, 6vw, 72px);
  }
  .copy p {
    margin: 0;
  }
  h1 {
    margin: 0;
    font: 400 clamp(64px, 11vw, 112px) / 0.92 var(--disp);
    letter-spacing: -0.02em;
    color: var(--text);
    text-shadow: 6px 6px 0 var(--pink);
  }
  h1 span {
    display: block;
  }
  .tagline {
    max-width: 30ch;
    font: 700 clamp(19px, 2.2vw, 23px) / 1.4 var(--body);
    text-wrap: pretty;
  }
  .quip {
    font: 400 18px/1.5 var(--body);
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-top: 6px;
  }

  .door-stage {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
    margin: 0 auto;
  }
  .breathe {
    animation: hs-breathe 7s ease-in-out infinite;
    animation-play-state: var(--breathe);
    transform-origin: 50% 100%;
  }
  /* Phones: scale the whole doorway down */
  @media (max-width: 560px) {
    .door-stage {
      zoom: 0.66;
    }
  }

  .sign {
    position: absolute;
    font: 700 13px/1 var(--mono);
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  /* a: crooked arch */
  .arch-door {
    position: relative;
    width: 380px;
    height: 520px;
    transform: perspective(900px) rotateY(calc(var(--tilt) * -10deg)) rotate(calc(var(--tilt) * -1.5deg));
    transform-origin: 50% 100%;
    transition: transform 0.5s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .arch-door:hover {
    transform: perspective(900px) rotateY(calc(var(--tilt) * -18deg)) rotate(calc(var(--tilt) * -3.5deg));
  }
  .arch {
    position: absolute;
    inset: 0;
    background: var(--sky);
    border: 4px solid var(--ink);
    border-bottom: none;
    border-radius: 190px 190px 0 0;
    box-shadow: 12px 0 0 var(--ink);
  }
  .portrait {
    position: absolute;
    left: 46px;
    right: 46px;
    bottom: 0;
    height: 310px;
    background: var(--cream);
    border: 4px solid var(--ink);
    border-bottom: none;
    border-radius: 150px 150px 0 0;
    overflow: hidden;
  }
  .knock {
    top: 118px;
    right: -46px;
    padding: 9px 15px;
    background: var(--ink);
    color: var(--cream);
    border: 2px solid var(--cream);
    box-shadow: 4px 4px 0 var(--pink);
    transform: rotate(8deg);
  }

  /* b: pink door left ajar */
  .ajar {
    position: relative;
    width: 360px;
    height: 500px;
    transform: rotate(calc(var(--tilt) * 1.5deg));
    transform-origin: 50% 100%;
  }
  .sky {
    position: absolute;
    inset: 0;
    background: var(--sky);
    border: 4px solid var(--ink);
    border-bottom: none;
    border-radius: 180px 180px 0 0;
    overflow: hidden;
  }
  .sky-portrait {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 78%;
  }
  .leaf {
    position: absolute;
    inset: -4px -4px 0 -4px;
    background: var(--pink);
    border: 4px solid var(--ink);
    border-bottom: none;
    border-radius: 184px 184px 0 0;
    transform-origin: 0 50%;
    transform: perspective(1400px) rotateY(-62deg);
    transition: transform 0.6s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .ajar:hover .leaf {
    transform: perspective(1400px) rotateY(-28deg);
  }
  .panel-inset {
    position: absolute;
    inset: 34px 34px 40px;
    border: 4px solid var(--ink);
    border-radius: 150px 150px 6px 6px;
  }
  .leaf .knob {
    position: absolute;
    right: 26px;
    top: 54%;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--mustard);
    border: 4px solid var(--ink);
  }
  .come-in {
    left: -70px;
    top: 70px;
    padding: 8px 13px;
    background: var(--cream);
    color: var(--ink);
    font-size: 12px;
    border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    transform: rotate(-7deg);
  }

  /* c: front door */
  .front {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    width: 320px;
    height: 520px;
    padding-top: 50px;
    background: var(--mustard);
    border: 4px solid var(--ink);
    border-bottom: none;
    border-radius: 16px 16px 0 0;
    box-shadow: 12px 0 0 var(--ink);
    transform: rotate(calc(var(--tilt) * 1.8deg)) skewX(calc(var(--tilt) * -1.5deg));
    transform-origin: 50% 100%;
    transition: transform 0.5s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .front:hover {
    transform: rotate(calc(var(--tilt) * -1deg)) skewX(calc(var(--tilt) * 1deg));
  }
  .peephole {
    position: relative;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--sky);
    border: 4px solid var(--ink);
    box-shadow: 0 0 0 12px var(--cream), 0 0 0 16px var(--ink);
  }
  .nameplate {
    padding: 7px 13px;
    background: var(--cream);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 4px;
    font: 700 13px/1 var(--mono);
    letter-spacing: 0.12em;
  }
  .slot {
    position: relative;
    width: 150px;
    height: 26px;
    background: var(--ink);
    border-radius: 5px;
  }
  .letter {
    position: absolute;
    left: 28px;
    top: -26px;
    padding: 8px 12px 18px;
    background: var(--cream);
    color: var(--ink);
    border: 3px solid var(--ink);
    font: 700 11px/1 var(--mono);
    letter-spacing: 0.12em;
    text-decoration: none;
    transform: rotate(-7deg);
    transition: transform 0.25s;
  }
  .letter:hover {
    color: var(--ink);
    transform: rotate(-2deg) translateY(-8px);
  }
  .front .knob {
    position: absolute;
    right: 26px;
    top: 330px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--cream);
    border: 4px solid var(--ink);
  }
</style>
