---
// Design: LightSwitch. a = toggle plate, b = pull chain, c = vintage push-button.
// Clicking any of them flips the whole house between dark and light (see src/scripts/house.ts).
import { design, type Variant } from '../../lib/data';

interface Props { size?: 'md' | 'sm'; variant?: Variant }
const { size = 'md', variant = design.switch } = Astro.props;
---
<button type="button" class:list={['switch', `v-${variant}`, size]} data-light-switch aria-label="Turn the lights on" aria-pressed="false">
  {variant === 'a' && (
    <>
      <span class="screw top"></span>
      <span class="screw bottom"></span>
      <span class="slot"><span class="lever"></span></span>
    </>
  )}
  {variant === 'b' && (
    <>
      <span class="cap"></span>
      <span class="pull"><span class="chain"></span><span class="bead"></span></span>
    </>
  )}
  {variant === 'c' && (
    <>
      <span class="btn-on"></span>
      <span class="btn-off"></span>
    </>
  )}
</button>

<style>
  .switch {
    position: relative;
    flex: none;
    padding: 0;
  }
  .switch.sm {
    zoom: 0.6;
  }

  /* a: toggle plate */
  .v-a {
    display: grid;
    place-items: center;
    width: 64px;
    height: 96px;
    background: var(--cream);
    border: 3px solid var(--ink);
    border-radius: 10px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .screw {
    position: absolute;
    left: 50%;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 50%;
    border: 2px solid var(--ink);
  }
  .screw.top { top: 7px; }
  .screw.bottom { bottom: 7px; }
  .slot {
    display: block;
    width: 22px;
    height: 44px;
    padding: 3px;
    background: var(--ink);
    border-radius: 5px;
  }
  .lever {
    display: block;
    width: 16px;
    height: 18px;
    background: var(--mustard);
    border: 2px solid var(--ink);
    border-radius: 3px;
    transform: translateY(20px);
    transition: transform 0.18s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  :global([data-theme='light']) .lever {
    transform: translateY(0);
  }

  /* b: pull chain */
  .v-b {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 64px;
    height: 150px;
    background: none;
    border: none;
  }
  .cap {
    width: 44px;
    height: 14px;
    background: var(--cream);
    border: 3px solid var(--ink);
    border-radius: 4px 4px 12px 12px;
  }
  .pull {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    transition: transform 0.16s ease-out;
  }
  .v-b:active .pull {
    transform: translateY(18px);
  }
  .chain {
    width: 4px;
    flex: 1;
    background: repeating-linear-gradient(var(--muted) 0 5px, transparent 5px 8px);
  }
  .bead {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--mustard);
    border: 3px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
  }

  /* c: vintage push-button (top pressed = lights on) */
  .v-c {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 64px;
    height: 96px;
    background: var(--cream);
    border: 3px solid var(--ink);
    border-radius: 32px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .btn-on,
  .btn-off {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 3px solid var(--ink);
    transition: all 0.12s;
  }
  .btn-on {
    background: var(--pink);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .btn-off {
    background: var(--ink);
    transform: translate(2px, 2px);
  }
  :global([data-theme='light']) .btn-on {
    box-shadow: none;
    transform: translate(2px, 2px);
  }
  :global([data-theme='light']) .btn-off {
    box-shadow: 3px 3px 0 var(--ink);
    transform: none;
  }
</style>
