---
// A blog post on the Library shelf. Styled like the Workshop cards.
import { url, tagSlug, formatDate, excerpt, type Post } from '../../lib/data';

interface Props { post: Post; color?: string }
const { post, color = 'sky' } = Astro.props;
const text = post.data.subtitle || excerpt(post.body);
---
<article class="card" data-color={color}>
  <p class="date">{formatDate(post.date)}</p>
  <h2><a href={post.href}>{post.data.title}</a></h2>
  <p class="excerpt">{text}</p>
  {post.data.tags.length > 0 && (
    <ul class="tags">
      {post.data.tags.map((t) => <li><a class="pill" href={url(`/tags#${tagSlug(t)}`)}>{t}</a></li>)}
    </ul>
  )}
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    background: var(--panel);
    border: 4px solid var(--ink);
    border-radius: 16px;
    box-shadow: 8px 8px 0 var(--ink);
    transition: transform 0.18s, box-shadow 0.18s;
  }
  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ink);
  }
  .date {
    margin: 0;
    font: 400 13px/1 var(--mono);
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  h2 {
    margin: 0;
    font: 700 clamp(22px, 3vw, 28px) / 1.15 var(--body);
    text-wrap: balance;
  }
  h2 a {
    text-decoration: none;
  }
  /* Whole card is clickable */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card {
    position: relative;
  }
  .excerpt {
    margin: 0;
    font: 400 17px/1.5 var(--body);
    color: var(--muted);
    max-width: 65ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .tags a {
    position: relative;
    z-index: 1;
    background: var(--accent);
    text-decoration: none;
  }
</style>
