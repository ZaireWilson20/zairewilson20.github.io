---
// Design: ProjectFrame variant a. Picture hung on a wire and nail, a little crooked; straightens on hover.
// The whole frame opens the project's detail modal.
import { url } from '../../lib/data';

interface Props { project: any }
const { project: p } = Astro.props;
const tilt = Number(p.tilt ?? 0);
---
<div class="hang" data-color={p.color ?? 'mustard'}>
  <div class="wire" aria-hidden="true"></div>
  <div class="nail" aria-hidden="true"></div>
  <a class="frame" href={`#${p.id}`} data-open-modal={p.id} style={`--frame-tilt: ${tilt}deg`}>
    <div class="shot">
      {p.image && <img src={url(`/assets/project/${p.image}`)} alt="" loading="lazy" />}
    </div>
    <div class="meta">
      <span class="years">{p.years}</span>
      {p.kind && <span class="pill">{p.kind}</span>}
    </div>
    <h3>{p.short_title ?? p.title}</h3>
    <p class="desc">{p.blurb ?? p.description}</p>
    <span class="more">See the details →</span>
  </a>
</div>

<style>
  .hang {
    position: relative;
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
    padding-top: 34px;
  }
  .wire {
    position: absolute;
    top: 7px;
    left: 22%;
    right: 22%;
    height: 30px;
    border: 2px solid var(--muted);
    border-bottom: none;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }
  .nail {
    position: absolute;
    top: 0;
    left: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 50%;
    background: var(--cream);
    border: 3px solid var(--ink);
    z-index: 1;
  }
  .frame {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px 14px 20px;
    background: var(--panel);
    color: var(--text);
    text-decoration: none;
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    transform: rotate(calc(var(--tilt) * var(--frame-tilt)));
    transform-origin: 50% -30px;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .frame:hover,
  .frame:focus-visible {
    color: var(--text);
    transform: rotate(0deg);
  }
  .shot {
    aspect-ratio: 16 / 10;
    border: 3px solid var(--ink);
    background: repeating-linear-gradient(135deg, var(--wall-2) 0 10px, var(--wall) 10px 20px);
    overflow: hidden;
  }
  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 0 4px;
  }
  .years {
    font: 400 13px/1 var(--mono);
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .pill {
    background: var(--accent);
  }
  h3 {
    margin: 0;
    padding: 0 4px;
    font: 700 24px/1.1 var(--body);
  }
  .desc {
    margin: 0;
    padding: 0 4px;
    font: 400 16px/1.5 var(--body);
    color: var(--muted);
    text-wrap: pretty;
  }
  .more {
    align-self: flex-start;
    margin: 2px 4px 0;
    font: 700 12px/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 3px solid var(--accent);
  }
</style>
