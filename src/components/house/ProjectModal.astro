---
// Project details, opened from a Hallway frame (or any [data-open-modal] link).
// Not in the Claude Design export; styled to match its panels, ink outlines, and hard shadows.
import { url } from '../../lib/data';

interface Props { project: any }
const { project: p } = Astro.props;
---
<dialog id={p.id} class="modal" data-color={p.color ?? 'mustard'} aria-labelledby={`${p.id}-title`}>
  <div class="sheet">
    <form method="dialog" class="close-form">
      <button class="close" aria-label="Close">&times;</button>
    </form>
    <header>
      <div class="meta">
        <span class="years">{p.date}</span>
        {p.kind && <span class="pill">{p.kind}</span>}
      </div>
      <h2 id={`${p.id}-title`}>{p.title}</h2>
      {p.summary && <p class="summary">{p.summary}</p>}
      {p.url && (
        <a class="visit" href={p.url} target="_blank" rel="noopener">Visit project ↗</a>
      )}
    </header>

    {(p.contents ?? []).map((c: any) => (
      <section class="block">
        <h3>{c.title}</h3>
        {c.image && <img class="shot" src={url(`/assets/project/${c.image}`)} alt={c.title} loading="lazy" />}
        <div class="rich" set:html={c.description ?? ''} />
        {c.videos && (
          <div class="videos">
            {c.videos.map((v: any) => (
              <div class="video">
                <p class="video-title">{v.title}</p>
                <div class="frame">
                  <iframe data-src={`https://www.youtube-nocookie.com/embed/${v.youtube}`} title={v.title} allowfullscreen></iframe>
                </div>
              </div>
            ))}
          </div>
        )}
        {c.blogPosts && (
          <div class="posts">
            <p>More on the development process:</p>
            <ul>
              {c.blogPosts.map((b: any) => <li><a href={url(`/${b.url}`)}>{b.title}</a></li>)}
            </ul>
          </div>
        )}
      </section>
    ))}
  </div>
</dialog>

<style>
  .modal {
    width: min(900px, calc(100vw - 24px));
    max-height: calc(100dvh - 48px);
    padding: 0;
    color: var(--text);
    background: var(--panel);
    border: 4px solid var(--ink);
    border-radius: 16px;
    box-shadow: 12px 12px 0 var(--ink);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .modal:focus-visible {
    outline: none;
  }
  .modal::backdrop {
    background: rgba(13, 12, 15, 0.72);
  }
  .sheet {
    position: relative;
    padding: clamp(20px, 4vw, 40px);
  }
  .close-form {
    position: sticky;
    top: 0;
    height: 0;
    display: flex;
    justify-content: flex-end;
    z-index: 2;
  }
  .close {
    width: 44px;
    height: 44px;
    padding: 0;
    background: var(--accent);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 50%;
    box-shadow: 3px 3px 0 var(--ink);
    font: 700 26px/1 var(--body);
  }
  .close:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding-bottom: 28px;
    margin-bottom: 8px;
    border-bottom: 3px solid var(--ink);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-right: 56px;
  }
  .years {
    font: 400 13px/1 var(--mono);
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .pill {
    background: var(--accent);
  }
  h2 {
    margin: 0;
    padding-right: 56px;
    font: 400 clamp(30px, 5vw, 44px) / 1.02 var(--disp);
    letter-spacing: -0.01em;
    text-shadow: 3px 3px 0 var(--accent);
    color: var(--text);
    text-wrap: balance;
  }
  .summary {
    margin: 0;
    font: 700 18px/1.4 var(--body);
  }
  .visit {
    font: 700 13px/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 3px solid var(--accent);
  }

  .block {
    padding-top: 28px;
  }
  h3 {
    margin: 0 0 12px;
    font: 700 22px/1.2 var(--body);
  }
  .shot {
    display: block;
    width: 100%;
    margin: 8px 0 16px;
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
  }

  /* Rich text coming from projects.yml (paragraphs, bare <li>s, code blocks) */
  .rich {
    font: 400 16px/1.6 var(--body);
    overflow-wrap: anywhere;
  }
  .rich :global(p) {
    margin: 0 0 14px;
  }
  .rich :global(li) {
    margin: 0 0 8px 20px;
  }
  .rich :global(b) {
    color: var(--text);
  }
  .rich :global(ol) {
    padding-left: 20px;
  }
  .rich :global(ol li) {
    margin-left: 0;
  }
  .rich :global(.highlight) {
    margin: 12px 0 18px;
    border: 3px solid var(--ink);
    border-radius: 8px;
    overflow: hidden;
  }
  .rich :global(pre) {
    margin: 0 !important;
    max-height: 480px;
    overflow: auto;
    font-size: 13px;
  }

  .videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 16px;
  }
  .video-title {
    margin: 0 0 8px;
    font: 700 12px/1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 3px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    background: var(--void);
  }
  .frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .posts {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 3px dashed var(--muted);
  }
  .posts p {
    margin: 0 0 6px;
    color: var(--muted);
  }
  .posts ul {
    margin: 0;
    padding-left: 20px;
  }
</style>
