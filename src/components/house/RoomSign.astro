---
// Design: RoomSign. a = quiet eyebrow + title, b = hanging enamel sign with a slow swing,
// c = arched door plate with the room number.
import { design, type Variant } from '../../lib/data';

interface Props {
  num: string;
  eyebrow: string;
  title: string;
  sub?: string;
  color?: 'pink' | 'sky' | 'mustard' | 'cream';
  as?: 'h1' | 'h2';
  variant?: Variant;
}
const { num, eyebrow, title, sub, color = 'pink', as: Heading = 'h2', variant = design.sign } = Astro.props;
---
<div class:list={['sign-wrap', 'wrap', `v-${variant}`]} data-color={color}>
  {variant === 'a' && (
    <>
      <p class="mono-label">{eyebrow}</p>
      <Heading class="title">{title}</Heading>
      {sub && <p class="sub">{sub}</p>}
    </>
  )}
  {variant === 'b' && (
    <>
      <div class="hanger" aria-hidden="true">
        <div class="wire"></div>
        <div class="nail"></div>
        <div class="plate">
          <span class="num">{num}</span>
          <span class="eyebrow">{eyebrow}</span>
        </div>
      </div>
      <Heading class="title">{title}</Heading>
      {sub && <p class="sub">{sub}</p>}
    </>
  )}
  {variant === 'c' && (
    <>
      <div class="door-plate" aria-hidden="true">
        <span class="screw"></span>
        <span class="big-num">{num}</span>
        <span class="room">ROOM</span>
        <span class="screw bottom"></span>
      </div>
      <div class="text">
        <p class="mono-label">{eyebrow}</p>
        <Heading class="title">{title}</Heading>
        {sub && <p class="sub">{sub}</p>}
      </div>
    </>
  )}
</div>

<style>
  .title {
    margin: 0;
    font-family: var(--body);
    font-weight: 800;
    line-height: 1;
    color: var(--text);
    text-wrap: balance;
  }
  .sub {
    margin: 0;
    font: 400 19px/1.5 var(--body);
    color: var(--muted);
    max-width: 52ch;
  }
  .mono-label {
    margin: 0;
  }

  /* a: quiet */
  .v-a {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .v-a .title {
    font-size: clamp(40px, 7vw, 64px);
    letter-spacing: -0.035em;
  }

  /* b: hanging enamel sign */
  .v-b {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .v-b .title {
    font-size: clamp(34px, 6vw, 48px);
    letter-spacing: -0.03em;
  }
  .v-b .sub {
    margin-top: -8px;
  }
  .hanger {
    position: relative;
    padding-top: 48px;
    transform-origin: 50% 0%;
    animation: hs-swing 5s ease-in-out infinite;
    animation-play-state: var(--breathe);
  }
  .wire {
    position: absolute;
    top: 8px;
    left: 16%;
    right: 16%;
    height: 44px;
    border: 2px solid var(--muted);
    border-bottom: none;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }
  .nail {
    position: absolute;
    top: 0;
    left: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 50%;
    background: var(--cream);
    border: 3px solid var(--ink);
  }
  .plate {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 26px 16px;
    background: var(--accent);
    border: 4px solid var(--ink);
    border-radius: 12px;
    box-shadow: 6px 6px 0 var(--ink);
  }
  .num {
    font: 700 12px/1 var(--mono);
    color: var(--ink);
    padding: 5px 7px;
    border: 2px solid var(--ink);
    border-radius: 50%;
  }
  .eyebrow {
    font: 400 clamp(28px, 5vw, 40px) / 1 var(--disp);
    color: var(--ink);
  }

  /* c: arched door plate */
  .v-c {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .door-plate {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex: none;
    width: 116px;
    height: 150px;
    background: var(--accent);
    border: 4px solid var(--ink);
    border-radius: 58px 58px 10px 10px;
    box-shadow: 6px 6px 0 var(--ink);
  }
  .screw {
    position: absolute;
    top: 16px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid var(--ink);
  }
  .screw.bottom {
    top: auto;
    bottom: 12px;
  }
  .big-num {
    font: 400 54px/1 var(--disp);
    color: var(--ink);
  }
  .room {
    font: 700 10px/1 var(--mono);
    letter-spacing: 0.2em;
    color: var(--ink);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    flex: 1 1 300px;
  }
  .v-c .title {
    font-size: clamp(38px, 6.5vw, 56px);
    letter-spacing: -0.035em;
  }
</style>
