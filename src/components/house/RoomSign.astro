---
// Design: RoomSign variant b. Hanging enamel sign that slowly swings.
interface Props {
  num: string;
  eyebrow: string;
  title: string;
  sub?: string;
  color?: 'pink' | 'sky' | 'mustard' | 'cream';
  as?: 'h1' | 'h2';
}
const { num, eyebrow, title, sub, color = 'pink', as: Heading = 'h2' } = Astro.props;
---
<div class="sign-wrap wrap" data-color={color}>
  <div class="hanger" aria-hidden="true">
    <div class="wire"></div>
    <div class="nail"></div>
    <div class="plate">
      <span class="num">{num}</span>
      <span class="eyebrow">{eyebrow}</span>
    </div>
  </div>
  <Heading class="title">{title}</Heading>
  {sub && <p class="sub">{sub}</p>}
</div>

<style>
  .sign-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .hanger {
    position: relative;
    padding-top: 48px;
    transform-origin: 50% 0%;
    animation: hs-swing 5s ease-in-out infinite;
    animation-play-state: var(--breathe);
  }
  .wire {
    position: absolute;
    top: 8px;
    left: 16%;
    right: 16%;
    height: 44px;
    border: 2px solid var(--muted);
    border-bottom: none;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  }
  .nail {
    position: absolute;
    top: 0;
    left: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 50%;
    background: var(--cream);
    border: 3px solid var(--ink);
  }
  .plate {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 26px 16px;
    background: var(--accent);
    border: 4px solid var(--ink);
    border-radius: 12px;
    box-shadow: 6px 6px 0 var(--ink);
  }
  .num {
    font: 700 12px/1 var(--mono);
    color: var(--ink);
    padding: 5px 7px;
    border: 2px solid var(--ink);
    border-radius: 50%;
  }
  .eyebrow {
    font: 400 clamp(28px, 5vw, 40px) / 1 var(--disp);
    color: var(--ink);
  }
  .title {
    margin: 0;
    font: 800 clamp(34px, 6vw, 48px) / 1 var(--body);
    letter-spacing: -0.03em;
    color: var(--text);
    text-wrap: balance;
  }
  .sub {
    margin: -8px 0 0;
    font: 400 19px/1.5 var(--body);
    color: var(--muted);
    max-width: 52ch;
  }
</style>
