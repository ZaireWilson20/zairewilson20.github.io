---
// Design: WorkshopItem. a = card with a status pill (lifts on hover), b = tag hanging on a pegboard,
// c = bench row with a label-maker strip. The Workshop grid switches to one column for c.
import { url, design, type Variant } from '../../lib/data';

interface Props { item: any; num?: string; variant?: Variant }
const { item, num = '01', variant = design.workshop } = Astro.props;
const status = [item.status, item.since && `Since ${item.since}`].filter(Boolean).join(' · ');
const tags: string[] = item.tags ?? [];
const isExternal = (href: string) => href.includes('://');
const links = [
  ...(item.project ? [{ label: 'More info', href: `#${item.project}`, modal: item.project }] : []),
  ...(item.links ?? []).map((l: any) => ({ label: l.label, href: isExternal(l.url) ? l.url : url(l.url), external: isExternal(l.url) })),
];
---
<article class:list={['item', `v-${variant}`]} data-color={item.color ?? 'pink'} style={`--item-tilt: ${Number(item.tilt ?? 0)}deg`}>
  {variant === 'a' && (
    <div class="card">
      <span class="pill status">{status}</span>
      <h3>{item.title}</h3>
      <p class="desc">{item.summary}</p>
      {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
      {links.length > 0 && (
        <div class="links">
          {links.map((l: any) => (
            <a href={l.href} data-open-modal={l.modal} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label} →</a>
          ))}
        </div>
      )}
    </div>
  )}
  {variant === 'b' && (
    <div class="pegboard">
      <div class="hook-wrap">
        <div class="hook" aria-hidden="true"></div>
        <div class="tag">
          <span class="hole" aria-hidden="true"></span>
          <span class="stamp">{status}</span>
          <h3>{item.title}</h3>
          <p class="desc">{item.summary}</p>
          {tags.length > 0 && <p class="tagline">{tags.join(' / ')}</p>}
          {links.length > 0 && (
            <div class="links">
              {links.map((l: any) => (
                <a href={l.href} data-open-modal={l.modal} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label} →</a>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  )}
  {variant === 'c' && (
    <div class="bench">
      <div class="bench-num">{num}</div>
      <div class="bench-body">
        <div class="bench-head">
          <h3>{item.title}</h3>
          <span class="label-strip">{status}</span>
        </div>
        <p class="desc">{item.summary}</p>
        {tags.length > 0 && <p class="tagline">{tags.join(' / ')}</p>}
        {links.length > 0 && (
          <div class="links">
            {links.map((l: any) => (
              <a href={l.href} data-open-modal={l.modal} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label} →</a>
            ))}
          </div>
        )}
      </div>
    </div>
  )}
</article>

<style>
  .item {
    height: 100%;
    min-width: 0;
  }
  h3 {
    margin: 0;
  }
  .desc {
    margin: 0;
    text-wrap: pretty;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .links a {
    font: 700 13px/1.4 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 3px solid var(--accent);
  }
  .tagline {
    margin: 0;
    font: 400 12px/1.3 var(--mono);
    letter-spacing: 0.06em;
  }

  /* a: card with status pill */
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    padding: 24px;
    background: var(--panel);
    border: 4px solid var(--ink);
    border-radius: 16px;
    box-shadow: 8px 8px 0 var(--ink);
    transition: transform 0.18s, box-shadow 0.18s;
  }
  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ink);
  }
  .status {
    align-self: flex-start;
    padding: 5px 12px;
    background: var(--accent);
    font-size: 12px;
  }
  .v-a h3 {
    font: 700 26px/1.1 var(--body);
    color: var(--text);
  }
  .v-a .desc {
    flex: 1;
    font: 400 17px/1.5 var(--body);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 5px 9px;
    background: var(--wall-2);
    color: var(--text);
    border-radius: 4px;
    font: 400 12px/1 var(--mono);
  }

  /* b: tag on a pegboard */
  .pegboard {
    display: flex;
    justify-content: center;
    height: 100%;
    padding: 28px 24px 34px;
    background-color: var(--wall-2);
    background-image: radial-gradient(var(--void) 3px, transparent 3.5px);
    background-size: 28px 28px;
    border: 4px solid var(--ink);
  }
  .hook-wrap {
    position: relative;
    width: 100%;
    max-width: 320px;
    padding-top: 28px;
  }
  .hook {
    position: absolute;
    top: 0;
    left: 50%;
    width: 18px;
    height: 30px;
    margin-left: -9px;
    border: 4px solid var(--ink);
    border-top: none;
    border-radius: 0 0 10px 10px;
    z-index: 1;
  }
  .tag {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 36px 20px 20px;
    background: var(--cream);
    color: var(--ink);
    border: 4px solid var(--ink);
    border-radius: 10px;
    box-shadow: 6px 6px 0 var(--ink);
    transform: rotate(calc(var(--tilt) * var(--item-tilt)));
    transform-origin: 50% 0%;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .tag:hover {
    transform: rotate(0deg);
  }
  .hole {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    border-radius: 50%;
    background: var(--wall-2);
    border: 3px solid var(--ink);
  }
  .stamp {
    align-self: flex-start;
    padding: 4px 8px;
    background: var(--accent);
    border: 2px solid var(--ink);
    font: 700 11px/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: rotate(-3deg);
  }
  .v-b h3 {
    font: 700 22px/1.1 var(--body);
  }
  .v-b .desc {
    font: 400 15px/1.45 var(--body);
  }
  .v-b .links a {
    color: var(--ink);
  }

  /* c: bench row with a label-maker strip */
  .bench {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 8px 24px;
    align-items: start;
    padding: 24px 0;
    border-top: 3px solid var(--panel);
  }
  .bench-num {
    font: 400 40px/1 var(--disp);
    color: var(--accent);
  }
  .bench-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .bench-head {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .v-c h3 {
    font: 700 24px/1.1 var(--body);
    color: var(--text);
  }
  .label-strip {
    padding: 6px 11px;
    background: var(--ink);
    color: var(--cream);
    border-radius: 3px;
    font: 700 12px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 var(--accent);
    transform: rotate(-2deg);
  }
  .v-c .desc {
    font: 400 17px/1.5 var(--body);
    color: var(--muted);
    max-width: 62ch;
  }
  .v-c .tagline {
    color: var(--muted);
  }
  @media (max-width: 520px) {
    .bench {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
