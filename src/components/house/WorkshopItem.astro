---
// Design: WorkshopItem variant a. Card with a status pill; lifts on hover.
import { url } from '../../lib/data';

interface Props { item: any }
const { item } = Astro.props;
const status = [item.status, item.since && `Since ${item.since}`].filter(Boolean).join(' · ');
const isExternal = (href: string) => href.includes('://');
---
<article class="item" data-color={item.color ?? 'pink'}>
  <span class="pill status">{status}</span>
  <h3>{item.title}</h3>
  <p class="desc">{item.summary}</p>
  {item.tags && (
    <ul class="tags">{item.tags.map((t: string) => <li>{t}</li>)}</ul>
  )}
  {(item.project || item.links) && (
    <div class="links">
      {item.project && <a href={`#${item.project}`} data-open-modal={item.project}>More info →</a>}
      {(item.links ?? []).map((l: any) => (
        <a href={isExternal(l.url) ? l.url : url(l.url)} {...(isExternal(l.url) ? { target: '_blank', rel: 'noopener' } : {})}>{l.label} →</a>
      ))}
    </div>
  )}
</article>

<style>
  .item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    min-width: 0;
    padding: 24px;
    background: var(--panel);
    border: 4px solid var(--ink);
    border-radius: 16px;
    box-shadow: 8px 8px 0 var(--ink);
    transition: transform 0.18s, box-shadow 0.18s;
  }
  .item:hover {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ink);
  }
  .status {
    align-self: flex-start;
    padding: 5px 12px;
    background: var(--accent);
    font-size: 12px;
  }
  h3 {
    margin: 0;
    font: 700 26px/1.1 var(--body);
    color: var(--text);
  }
  .desc {
    flex: 1;
    margin: 0;
    font: 400 17px/1.5 var(--body);
    text-wrap: pretty;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 5px 9px;
    background: var(--wall-2);
    color: var(--text);
    border-radius: 4px;
    font: 400 12px/1 var(--mono);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .links a {
    font: 700 13px/1.4 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 3px solid var(--accent);
  }
</style>
