---
import House from '../layouts/House.astro';
import RoomSign from '../components/house/RoomSign.astro';
import Button from '../components/house/Button.astro';
import Floor from '../components/house/Floor.astro';
import { url } from '../lib/data';
---
<House title="Wrong door">
  <section class="room">
    <RoomSign as="h1" num="??" eyebrow="Wrong Door" title="Nothing behind this one." sub="That page doesn't exist, or it moved to another room." color="pink" />
    <div class="wrap actions">
      <Button href={url('/')} color="mustard">Back to the front door</Button>
      <Button href={url('/blog')} color="panel">Browse the blog</Button>
    </div>
  </section>
  <Floor />
</House>

<style>
  .room {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: clamp(40px, 7vw, 80px) clamp(56px, 8vw, 96px);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    width: 100%;
  }
</style>
