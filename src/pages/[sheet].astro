---
// Component sheet: every variant of every house component, side by side, with real content.
// Dev only. `npm run dev`, then open /sheet. The production build skips this page.
import House from '../layouts/House.astro';
import Nav from '../components/house/Nav.astro';
import LightSwitch from '../components/house/LightSwitch.astro';
import Hero from '../components/house/Hero.astro';
import Avatar from '../components/house/Avatar.astro';
import Floor from '../components/house/Floor.astro';
import RoomSign from '../components/house/RoomSign.astro';
import WorkshopItem from '../components/house/WorkshopItem.astro';
import ProjectFrame from '../components/house/ProjectFrame.astro';
import ProjectModal from '../components/house/ProjectModal.astro';
import GalleryTile from '../components/house/GalleryTile.astro';
import Button from '../components/house/Button.astro';
import Footer from '../components/house/Footer.astro';
import { now, projects, gallery, design } from '../lib/data';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { sheet: 'sheet' } }] : [];
}

const abc = ['a', 'b', 'c'] as const;
const notes: Record<string, Record<string, string>> = {
  nav: { a: 'Text links, underline on current room', b: 'Floor-plan strip, current room filled', c: 'Crooked door plaques, straighten on hover' },
  switch: { a: 'Toggle plate', b: 'Pull chain', c: 'Vintage push-button' },
  hero: { a: 'Crooked arch. Hover leans it further.', b: 'Pink door left ajar onto open sky. Hover swings it shut-ish.', c: 'Front door with peephole, nameplate, and a résumé in the mail slot' },
  avatar: { a: 'Multiplied onto the wall color', b: 'Flattened: blurred, extra contrast', c: 'Ink duotone, posterized' },
  floor: { a: 'Perspective checker', b: 'Flat tile with a mustard baseboard', c: 'Pink argyle, off-kilter horizon' },
  sign: { a: 'Quiet: eyebrow + title', b: 'Hanging enamel sign, slow swing', c: 'Arched door plate with room number' },
  workshop: { a: 'Card with status pill, lifts on hover', b: 'Tag hanging on a pegboard', c: 'Bench row with a label-maker strip (room becomes one column)' },
  frame: { a: 'Picture wire + nail. Hover to straighten.', b: 'Museum mat. The frame is crooked, the label is level.', c: 'Arched frame echoing the doorway; color = category' },
  tile: { a: 'Colored mat', b: 'On a plinth', c: 'Under a spotlight' },
  button: { a: 'Pill, hard shadow, presses flat', b: 'Doorbell plate', c: 'Inline link, fill rises on hover' },
  footer: { a: 'Doormat', b: 'Basement: baseboard + wall outlet' },
};
const groups = Object.keys(notes);
const isOn = (key: string, v: string) => (design as any)[key] === v;
---
<House title="Component sheet">
  <div class="sheet wrap">
    <header class="intro">
      <p class="mono-label">Dev only · not in the production build</p>
      <h1>Component sheet</h1>
      <p>
        Every variant of every house component, using the site's real content. To use one on the site, set the line shown
        under it in <code>src/data/design.yml</code> and save. The <span class="live">LIVE</span> badge marks what the site uses now.
        The light switches here flip the whole page, so you can check both themes.
      </p>
      <nav class="jump" aria-label="Components">
        {groups.map((g) => <a href={`#sheet-${g}`}>{g}</a>)}
      </nav>
    </header>
  </div>

  {groups.map((key, gi) => (
    <section class="group" id={`sheet-${key}`}>
      <div class="wrap group-head">
        <span class="gnum">{String(gi + 1).padStart(2, '0')}</span>
        <h2>{key}</h2>
      </div>
      <div class:list={['options', ['hero', 'nav', 'footer', 'floor'].includes(key) ? 'wide' : 'wrap']}>
        {Object.keys(notes[key]).map((v) => (
          <div class="option">
            <div class="wrap label-row">
              <span class="oid">{key}-{v}</span>
              <span class="note">{notes[key][v]}</span>
              <code class="cfg">{key}: {v}</code>
              {isOn(key, v) && <span class="live">LIVE</span>}
            </div>
            <div class:list={['stage', `stage-${key}`]}>
              {key === 'nav' && <Nav variant={v as any} switchVariant={v as any} />}
              {key === 'switch' && <LightSwitch variant={v as any} />}
              {key === 'hero' && (<><Hero variant={v as any} /><Floor /></>)}
              {key === 'avatar' && (
                <div class="avatar-box" data-av={v}><Avatar variant={v as any} /></div>
              )}
              {key === 'floor' && (<><div class="floor-gap"></div><Floor variant={v as any} /></>)}
              {key === 'sign' && <RoomSign variant={v as any} num="02" eyebrow="The Hallway" title="Selected Work" sub="Games, simulations, and research, hung roughly in order." color="sky" />}
              {key === 'workshop' && (
                <div class:list={['wrap', v === 'c' ? 'bench-list' : 'grid-3']}>
                  {now.map((item, i) => <WorkshopItem item={item} num={String(i + 1).padStart(2, '0')} variant={v as any} />)}
                </div>
              )}
              {key === 'frame' && (
                <div class="wrap grid-3 frames">
                  {projects.slice(0, 3).map((p) => <ProjectFrame project={p} variant={v as any} />)}
                </div>
              )}
              {key === 'tile' && (
                <div class="wrap gallery">
                  {gallery.map((t) => <GalleryTile tile={t} variant={v as any} />)}
                </div>
              )}
              {key === 'button' && (
                <div class="wrap buttons">
                  <Button href="#" color="mustard" variant={v as any}>Resume →</Button>
                  <Button href="#" color="panel" variant={v as any}>GitHub</Button>
                  <Button href="#" color="pink" variant={v as any}>Say hi</Button>
                </div>
              )}
              {key === 'footer' && <Footer variant={v as any} />}
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  {projects.filter((p) => p.modal).map((p) => <ProjectModal project={p} />)}
</House>

<style>
  .sheet {
    padding-block: 48px 24px;
  }
  .intro h1 {
    margin: 10px 0 12px;
    font: 400 clamp(44px, 7vw, 72px) / 1 var(--disp);
    text-shadow: 4px 4px 0 var(--pink);
  }
  .intro p {
    max-width: 70ch;
    margin: 0 0 12px;
    color: var(--muted);
  }
  .intro code,
  .cfg {
    padding: 2px 6px;
    background: var(--panel);
    border-radius: 4px;
    font: 400 13px/1.4 var(--mono);
    color: var(--text);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 20px;
  }
  .jump a {
    font: 700 13px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 3px solid var(--mustard);
    padding-bottom: 2px;
  }

  .group {
    padding-block: 40px 56px;
    border-top: 4px solid var(--ink);
    scroll-margin-top: 12px;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 20px;
  }
  .gnum {
    font: 700 12px/1 var(--mono);
    color: var(--muted);
  }
  .group h2 {
    margin: 0;
    font: 800 28px/1 var(--body);
    text-transform: capitalize;
  }
  .options {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .options.wrap {
    padding-inline: 0;
  }
  .label-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-bottom: 14px;
  }
  .options.wrap .label-row {
    padding-inline: var(--gutter);
  }
  .oid {
    padding: 3px 8px;
    background: var(--ink);
    color: var(--cream);
    border-radius: 4px;
    font: 700 12px/1.3 var(--mono);
  }
  .note {
    color: var(--muted);
    font-size: 15px;
  }
  .live {
    padding: 3px 8px;
    background: var(--mustard);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font: 700 11px/1 var(--mono);
    letter-spacing: 0.1em;
  }
  .stage {
    background: var(--wall);
  }
  .stage-nav,
  .stage-footer,
  .stage-hero,
  .stage-floor {
    border-block: 3px dashed var(--panel);
  }
  .stage-switch {
    display: flex;
    padding-inline: var(--gutter);
  }
  .floor-gap {
    height: 40px;
  }
  .avatar-box {
    position: relative;
    width: 240px;
    height: 280px;
    margin-inline: var(--gutter);
    border: 4px solid var(--ink);
    border-radius: 120px 120px 0 0;
    overflow: hidden;
  }
  .avatar-box[data-av='a'] { background: var(--cream); }
  .avatar-box[data-av='b'] { background: var(--sky); }
  .avatar-box[data-av='c'] { background: var(--pink); }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 32px;
  }
  .frames {
    gap: 64px 48px;
    align-items: start;
    padding-top: 8px;
  }
  .bench-list {
    display: flex;
    flex-direction: column;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 40px;
    align-items: center;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }
</style>
