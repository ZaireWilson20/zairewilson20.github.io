---
import House from '../../layouts/House.astro';
import RoomSign from '../../components/house/RoomSign.astro';
import PostCard from '../../components/house/PostCard.astro';
import { url, type Post } from '../../lib/data';

// Page 1 is /blog, later pages are /blog/page2, /blog/page3 ... (same as the old Jekyll paginate_path)
export async function getStaticPaths() {
  const { getPosts, site } = await import('../../lib/data');
  const posts = await getPosts();
  const size = site.paginate ?? 5;
  const totalPages = Math.max(1, Math.ceil(posts.length / size));
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: i === 0 ? undefined : `page${i + 1}` },
    props: { current: i + 1, totalPages, posts: posts.slice(i * size, (i + 1) * size) },
  }));
}

interface Props { current: number; totalPages: number; posts: Post[] }
const { current, totalPages, posts } = Astro.props;
const pageHref = (n: number) => url(n === 1 ? '/blog' : `/blog/page${n}`);
const colors = ['sky', 'pink', 'mustard', 'cream'];
---
<House title={current > 1 ? `Blog, page ${current}` : 'Blog'} description="Dev notes and design thoughts from Zaire Wilson." current="blog">
  <section class="room">
    <RoomSign as="h1" num="05" eyebrow="The Library" title="Blog" sub="Dev notes, breakdowns, and design thoughts." color="sky" />
    <div class="wrap shelf">
      {posts.length === 0 && <p class="empty">Nothing on the shelf yet.</p>}
      {posts.map((post, i) => <PostCard post={post} color={colors[i % colors.length]} />)}
    </div>

    {totalPages > 1 && (
      <nav class="wrap pager" aria-label="Blog pages">
        {current > 1 && <a href={pageHref(current - 1)}>← Newer</a>}
        <span>Page {current} of {totalPages}</span>
        {current < totalPages && <a href={pageHref(current + 1)}>Older →</a>}
      </nav>
    )}
  </section>
</House>

<style>
  .room {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: clamp(40px, 7vw, 80px) clamp(64px, 9vw, 104px);
  }
  .shelf {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
  }
  .empty {
    color: var(--muted);
  }
  .pager {
    display: flex;
    align-items: center;
    gap: 24px;
    font: 700 14px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pager span {
    color: var(--muted);
  }
</style>
