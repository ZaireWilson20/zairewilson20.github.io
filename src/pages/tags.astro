---
import House from '../layouts/House.astro';
import RoomSign from '../components/house/RoomSign.astro';
import { getTags, tagSlug, formatDate } from '../lib/data';

const tags = [...(await getTags()).entries()];
const colors = ['pink', 'sky', 'mustard', 'cream'];
---
<House title="Tags" description="Blog posts by topic." current="blog">
  <section class="room">
    <RoomSign as="h1" num="05" eyebrow="The Card Catalog" title="Tags" sub="Every post, filed by topic." color="mustard" />
    <div class="wrap">
      <ul class="cloud">
        {tags.map(([tag, posts], i) => (
          <li><a class="pill" data-color={colors[i % colors.length]} href={`#${tagSlug(tag)}`}>{tag} <span>{posts.length}</span></a></li>
        ))}
      </ul>
      {tags.map(([tag, posts], i) => (
        <section class="drawer" id={tagSlug(tag)} data-color={colors[i % colors.length]}>
          <h2>{tag}</h2>
          <ul>
            {posts.map((post) => (
              <li>
                <span class="date">{formatDate(post.date)}</span>
                <a href={post.href}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</House>

<style>
  .room {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: clamp(40px, 7vw, 80px) clamp(64px, 9vw, 104px);
  }
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 40px;
    padding: 0;
    list-style: none;
  }
  .cloud a {
    padding: 8px 14px;
    font-size: 13px;
    background: var(--accent);
    text-decoration: none;
    box-shadow: 3px 3px 0 var(--ink);
  }
  .cloud span {
    opacity: 0.7;
  }
  .drawer {
    max-width: 900px;
    margin-bottom: 32px;
    padding: 22px 24px;
    background: var(--panel);
    border: 4px solid var(--ink);
    border-left: 14px solid var(--accent);
    border-radius: 12px;
    box-shadow: 8px 8px 0 var(--ink);
    scroll-margin-top: 24px;
  }
  h2 {
    margin: 0 0 12px;
    font: 800 26px/1.1 var(--body);
  }
  .drawer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .drawer li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    padding: 10px 0;
    border-top: 2px solid var(--wall-2);
  }
  .date {
    font: 400 13px/1.6 var(--mono);
    color: var(--muted);
    min-width: 170px;
  }
  .drawer a {
    font-weight: 700;
  }
</style>
